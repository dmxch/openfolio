# OpenFolio Konfiguration
# Kopiere diese Datei zu .env und passe die Werte an
# Oder nutze ./init.sh für automatische Konfiguration

# Datenbank
POSTGRES_USER=openfolio
# Das Passwort steht unverändert in DATABASE_URL. Erlaubt sind Buchstaben, Ziffern und die Zeichen - _ . ~
# Die Zeichen @ : / ? # % brechen die URL. Wer DATABASE_URL selbst setzt, kodiert Sonderzeichen als %XX
# (zum Beispiel %40 für @).
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=openfolio

# Sicherheit
JWT_SECRET=CHANGE_ME_MIN_32_ZEICHEN
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE
REDIS_PASSWORD=CHANGE_ME_RANDOM

# API Docs (auf true setzen für Entwicklung)
# ENABLE_API_DOCS=true

# Initialer Admin (nur beim ersten Start nötig — nach Erstellung aus .env entfernen)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
# UPTIME_KUMA_PORT=3001

# Eigene Domain (für Reverse Proxy Setup)
# Einzige Quelle für beide Werte — docker-compose.yml reicht sie durch.
# NICHT zusätzlich in docker-compose.override.yml setzen (Literal dort
# überschreibt diese .env still). CORS_ORIGINS ist kommagetrennt (mehrere Origins).
# CORS_ORIGINS=https://deine-domain.com
# FRONTEND_URL=https://deine-domain.com
# Anzahl Proxys vor dem Backend, die X-Forwarded-For setzen oder ergaenzen (Default 1, siehe README).
# TRUSTED_PROXY_HOPS=1

# Externe APIs:
# FRED, FMP und Finnhub API-Keys werden NICHT mehr ueber Umgebungsvariablen
# konfiguriert. Jeder User traegt seine eigenen Keys nach dem Login unter
# Einstellungen → Integrationen ein. Die Keys werden verschluesselt in der
# Datenbank gespeichert.
# - FRED:    https://fred.stlouisfed.org/docs/api/api_key.html  (gratis)
# - FMP:     https://site.financialmodelingprep.com/developer/docs  (gratis 250 calls/Tag)
# - Finnhub: https://finnhub.io/register  (gratis 60 calls/Min)
#
# AUSNAHME — EPS-Scanner: Der Worker-Job holt die Quartals-EPS-Reihen mit
# EINEM gemeinsamen System-Finnhub-Key (nicht per-User). Hier eintragen,
# sonst faellt der Job auf den langsamen yfinance-Fallback zurueck.
# Free-Tier (60 calls/Min) reicht. Status pruefbar via GET /api/eps-scanner/status.
FINNHUB_SYSTEM_API_KEY=
# System-Keys fuer FMP und FRED: globale Jobs nehmen sie anstelle eines Nutzer-Keys.
# Leer = Key des aeltesten Admin-Kontos; Keys anderer Nutzer speisen keine globalen Jobs.
# FMP_SYSTEM_API_KEY=
# FRED_SYSTEM_API_KEY=

# Risk-free rate (annualisiert, %) fuer Sharpe/Sortino/Calmar/Information-Ratio
# auf der Performance-Seite. Default 0 = Excess-Return ueber Cash. Optional auf den
# SARON/CHF-Geldmarktsatz setzen (z.B. 1.25). Additive Kennzahl, beruehrt keine
# geschuetzte Performance-Berechnung.
RISK_FREE_RATE_PCT=0

# ntfy Push (SSRF-Schutz): Server-URLs, die auf interne/private Adressen zeigen,
# werden abgelehnt. Hostnamen (kommagetrennt, exakt, case-insensitive), die der
# Betreiber ausdruecklich freigibt. Fuer den optionalen self-hosted ntfy-Container
# aus docker-compose.yml (Server-URL "http://ntfy:80") hier "ntfy" eintragen.
# NTFY_ALLOWED_PRIVATE_HOSTS=ntfy

# SMTP der Nutzer (SSRF-Schutz): Ein SMTP-Server aus den Einstellungen eines Nutzers
# muss auf oeffentliche Adressen zeigen, sonst wird er abgelehnt und nicht kontaktiert.
# Hostnamen (kommagetrennt, exakt, case-insensitive), die der Betreiber ausdruecklich
# freigibt, zum Beispiel ein Mailrelay im eigenen Netz. Die Liste gilt nur fuer SMTP,
# nicht fuer ntfy. Das globale SMTP unten (SMTP_HOST) braucht keinen Eintrag.
# SMTP_ALLOWED_PRIVATE_HOSTS=mailrelay.intern

# Obergrenze fuer die Laufzeit einer SQL-Abfrage des Backends in Millisekunden (0 = aus, gilt nicht fuer den Worker).
# DB_STATEMENT_TIMEOUT_MS=0

# E-Mail (optional — für Alert-Benachrichtigungen)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=smtp_passwort

# Monitoring (optional — nur für docker-compose.monitoring.yml)
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=CHANGE_ME

# Legacy (nur bei Migration von alter Version)
# LEGACY_ENCRYPTION_KEY=nur_setzen_wenn_migration_von_alter_version
#
# Null-Schluessel: Ohne LEGACY_ENCRYPTION_KEY liest das Backend Altwerte auch mit einem
# oeffentlich bekannten Schluessel aus 32 Nullen. Er bleibt aktiv (Default true), damit
# solche Altwerte lesbar bleiben. Ob deine Instanz welche hat, zeigt der Dry-Run.
# So schaltest du ihn ab:
#   1. docker compose exec backend python scripts/vr11_reencrypt_legacy_fields.py          (Dry-Run, zaehlt)
#   2. docker compose exec backend python scripts/vr11_reencrypt_legacy_fields.py --apply  (verschluesselt neu)
#   3. LEGACY_NULL_KEY_ENABLED=false setzen und Backend und Worker neu starten.
# LEGACY_NULL_KEY_ENABLED=true
